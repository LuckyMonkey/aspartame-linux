+++ b/src/jarabe/controlpanel/gui.py
@@ -88,6 +88,15 @@
         key_controller.connect('key-pressed', self.__key_press_event_cb)
         self.add_controller(key_controller)
 
+        # This window is not a Gtk.ApplicationWindow, so 'window-added'
+        # never fires for it and the shell's key handler never attached.
