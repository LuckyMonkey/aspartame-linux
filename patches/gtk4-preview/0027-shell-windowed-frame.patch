+        }
+
+        def _sugar_key_pressed(_controller, keyval, _keycode, _state):
+            level = zoom_keys.get(keyval)
+            if level is None:
+                return False
+            shell_instance.set_zoom_level(level)
+            return True
+
+        key_controller.connect("key-pressed", _sugar_key_pressed)
