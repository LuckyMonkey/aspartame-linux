+
+    @service.method(_DBUS_SHELL_IFACE, in_signature='', out_signature='b')
+    def ShowControlPanel(self):
+        """Open GTK4 Settings with the shell as its transient owner."""
+        if self._shell_model.has_modal():
+            return False
+        from jarabe.controlpanel.gui import ControlPanel
+        panel = ControlPanel(0)
+        main_window = getattr(self._shell_model, '_main_window', None)
+        if main_window is not None:
+            panel.set_transient_for(main_window)
+        panel.set_visible(True)
+        self._control_panel = panel
+        return True
