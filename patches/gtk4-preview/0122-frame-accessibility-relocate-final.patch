From: Aspartame GTK4 migration
Subject: [PATCH] gtk4: relocate Frame accessibility calls finally

The persistent preview source may contain the calls in `do_dispose` after
earlier context drift. Move them to `FrameContainer.__init__` immediately
after `_position` is initialized.

--- a/src/jarabe/frame/framewindow.py
+++ b/src/jarabe/frame/framewindow.py
@@ -52,13 +52,13 @@
     def __init__(self, position):
         super().__init__()
         self._position = position
+        self.update_property([Gtk.AccessibleProperty.LABEL], [_('Frame')])
+        self.set_accessible_role(Gtk.AccessibleRole.GROUP)
 
         if self.is_vertical():
             self._box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
         else:
             self._box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
         self._box.set_parent(self)
 
     def do_dispose(self):
-        self.update_property([Gtk.AccessibleProperty.LABEL], [_('Frame')])
-        self.set_accessible_role(Gtk.AccessibleRole.GROUP)
         if self._box:
