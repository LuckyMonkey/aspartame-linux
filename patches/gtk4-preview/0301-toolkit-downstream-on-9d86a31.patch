+def get_command(bundle):
+    """Resolve a bundle command to the isolated GTK4 launcher.
 
+    A GTK3 entry point must never be silently rewritten into a GTK4 process:
+    the two GI namespaces are separate runtime worlds.  Generic Sugar
+    launchers are intentionally redirected to the GTK4 wrapper, while an
+    explicit GTK3 launcher is rejected with an actionable error.
+    """
+    command = shlex.split(bundle.get_command())
+    if not command:
+        raise ValueError("Activity bundle has no launch command")
+    launcher_name = os.path.basename(command[0])
+    if launcher_name == "sugar-activity3":
+        raise RuntimeError(
+            "GTK3 bundle cannot run inside isolated GTK4 Activity compositor"
+        )
+    if launcher_name in ("sugar-activity", "sugar-activity4"):
+        # Prefer a bundle-local launcher so Activities carry their runtime
+        # boundary without relying on the shell's PATH.
+        local_launcher = os.path.join(bundle.get_path(), "bin", "sugar-activity4")
+        command[0] = (local_launcher if os.path.isfile(local_launcher)
+                      else os.environ.get("SUGAR_ACTIVITY4", "sugar-activity4"))
+    return command
 
