From: Aspartame GTK4 migration
Subject: [PATCH] home: do not advertise missing Activity bundles

The preview profile can retain favorites for Activities removed from the
modern prefix.  Showing those entries makes function-key and icon activation
launch a nonexistent bundle and leaves a failed full-screen launcher.

---
 src/jarabe/desktop/favoritesview.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/jarabe/desktop/favoritesview.py b/src/jarabe/desktop/favoritesview.py
--- a/src/jarabe/desktop/favoritesview.py
+++ b/src/jarabe/desktop/favoritesview.py
@@ -15,6 +15,7 @@
 
 import logging
+import os
 from gettext import gettext as _
@@ -255,6 +256,10 @@ def _add_activity(self, activity_info):
         if not activity_info.get_show_launcher():
             return
+        bundle_path = activity_info.get_path()
+        if not bundle_path or not os.path.isdir(bundle_path):
+            logging.warning('Skipping favorite with missing bundle: %s',
+                            activity_info.get_bundle_id())
+            return
 
         icon = ActivityIcon(activity_info)
