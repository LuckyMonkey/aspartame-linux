+        semantic_keys.add_window(home_window)
+    shell_instance.stack.set_visible_child_name("home")
+
+    os.environ["WAYLAND_DISPLAY"] = "wayland-sugar"
+    if "DISPLAY" in os.environ:
+        del os.environ["DISPLAY"]
+
+    session_manager = get_session_manager()
+
+    _complete_desktop_startup()
+
+    # Clear the startup 'wait' cursor now that the desktop is ready.
+    # busy() was called in HomeWindow.__init__; unbusy() matches it.
+    GLib.idle_add(home_window.unbusy)
+
+
+def __intro_window_done_cb(window):
+    _begin_desktop_startup()
+
+    global _window_manager_started
+    if _window_manager_started:
+        _complete_desktop_startup()
+
+
+def cleanup_temporary_files():
+    try:
+        # see http://bugs.sugarlabs.org/ticket/1876
+        data_dir = os.path.join(env.get_profile_path(), 'data')
+        shutil.rmtree(data_dir, ignore_errors=True)
+        os.makedirs(data_dir)
+    except OSError as e:
+        # non-fatal: full or read-only disk should not block startup
+        logging.warning('temporary files cleanup failed: %s', e)
+
+
+def setup_timezone():
+    settings = Gio.Settings.new('org.sugarlabs.date')
+    timezone = settings.get_string('timezone')
+    if timezone is not None and timezone:
+        os.environ['TZ'] = timezone
+
+
+def setup_fonts():
+    settings = Gio.Settings.new('org.sugarlabs.font')
+    face = settings.get_string('default-face')
+    size = settings.get_double('default-size')
+
+    gtk_settings = Gtk.Settings.get_default()
+    gtk_settings.set_property('gtk-font-name', '%s %f' % (face, size))
+
+
+def setup_proxy():
+    protos = ['http', 'https', 'ftp', 'socks']
+    env_variables = ['{}_proxy'.format(proto) for proto in protos]
+    schemas = ['org.sugarlabs.system.proxy.{}'.format(
+        proto) for proto in protos]
+
+    g_mode = Gio.Settings.new('org.sugarlabs.system.proxy').get_string('mode')
+    if g_mode == 'manual':
+        counter = 0
+        for schema in schemas:
+            setting_schema = Gio.Settings.new(schema)
+
+            if ((env_variables[counter] == 'http_proxy') and
+                    setting_schema.get_boolean('use-authentication')):
+                text_to_set = "%s://%s:%s@%s:%s/" % (
+                    protos[counter],
+                    setting_schema.get_string('authentication-user'),
+                    setting_schema.get_string('authentication-password'),
+                    setting_schema.get_string('host'),
+                    str(setting_schema.get_int('port')))
+            else:
+                text_to_set = "%s://%s:%s/" % (
+                    protos[counter],
+                    setting_schema.get_string('host'),
+                    str(setting_schema.get_int('port')))
+
+            os.environ[env_variables[counter]] = text_to_set
+            os.environ[env_variables[counter].upper()] = text_to_set
+            counter += 1
+        os.environ['no_proxy'] = ",".join(Gio.Settings.new(
+            'org.sugarlabs.system.proxy').get_strv('ignore-hosts'))
+
+    elif g_mode == 'none':
+        for each_env_variable in env_variables:
+            if each_env_variable in os.environ:
+                del os.environ[each_env_variable]
+
+
+def setup_theme():
+    from gi.repository import Gdk
+    gtk_settings = Gtk.Settings.get_default()
+    sugar_theme = 'sugar-72'
+    if 'SUGAR_SCALING' in os.environ:
+        if os.environ['SUGAR_SCALING'] == '100':
+            sugar_theme = 'sugar-100'
+    # gtk-theme-name is deprecated in GTK4 and ignored on Wayland/Casilda.
+    # GTK_THEME env variable in run_sugar.sh handles the theme name correctly.
+    gtk_settings.set_property('gtk-icon-theme-name', 'sugar')
+    gtk_settings.set_property('gtk-cursor-blink-timeout', 3)
+    gtk_settings.set_property('gtk-overlay-scrolling', False)
+
+    # GTK4 / Wayland fix: when Casilda compositor connects (~2 sec after start),
+    # the Wayland display replaces the initial display and any CssProvider added
+    # via add_provider_for_display() on the old display is lost → colors fade.
+    #
+    # Solution: write Sugar CSS import to ~/.config/gtk-4.0/gtk.css which GTK4
+    # loads automatically at PRIORITY_USER (800) on EVERY display — including
+    # after Wayland reconnects. Nothing can override PRIORITY_USER.
+    css_path = '/usr/share/themes/%s/gtk-4.0/gtk.css' % sugar_theme
+    if os.path.exists(css_path):
+        user_css_dir = os.path.expanduser('~/.config/gtk-4.0')
+        os.makedirs(user_css_dir, exist_ok=True)
+        user_css_file = os.path.join(user_css_dir, 'gtk.css')
+        try:
+            with open(user_css_file, 'w') as f:
+                f.write('/* Sugar GTK4 theme — auto-written by jarabe/main.py */\n')
+                f.write('@import url("%s");\n' % css_path)
+            logging.debug('Sugar GTK4 theme pinned at user priority: %s', user_css_file)
+        except OSError as e:
+            logging.warning('Could not write user CSS: %s', e)
+
+        # Also load via provider for the current display (belt-and-suspenders).
+        # Guard: Gdk.Display.get_default() can return None in gdm3 Wayland
+        # session before the display is fully initialized.
+        _display = Gdk.Display.get_default()
+        if _display is not None:
+            provider = Gtk.CssProvider()
+            provider.load_from_path(css_path)
+            Gtk.StyleContext.add_provider_for_display(
+                _display,
+                provider,
+                Gtk.STYLE_PROVIDER_PRIORITY_USER)
+        else:
+            logging.warning('setup_theme: display not ready yet, skipping '
+                            'add_provider_for_display (user CSS already written)')
+    else:
+        logging.warning('Sugar GTK4 theme not found at %s', css_path)
+
+    icons_path = os.path.join(config.data_path, 'icons')
+    _display = Gdk.Display.get_default()
+    if _display is not None:
+        Gtk.IconTheme.get_for_display(_display).add_search_path(icons_path)
+    else:
+        logging.warning('setup_theme: display not ready, icon search path '
+                        'not set — will be applied after display opens')
+
+
+
+def _setup_main_window(shell_instance):
+    if not shell_instance._main_window:
+        shell_instance._main_window = Gtk.ApplicationWindow(application=shell_instance)
+        shell_instance._main_window.set_focusable(True)
+        shell_instance._main_window.set_title("Sugar")
+
+        shell_instance._overlay = Gtk.Overlay()
+        shell_instance._overlay.set_child(shell_instance.stack)
+
+        shell_instance._main_window.set_child(shell_instance._overlay)
+        from gi.repository import Gdk
+        semantic_keys = keyhandler.get_instance()
+        zoom_keys = {
+            Gdk.KEY_F1: shell_instance.ZOOM_MESH,
+            Gdk.KEY_F2: shell_instance.ZOOM_GROUP,
+            Gdk.KEY_F3: shell_instance.ZOOM_HOME,
+            Gdk.KEY_F4: shell_instance.ZOOM_ACTIVITY,
+        }
+        space_keys = (Gdk.KEY_F7, Gdk.KEY_F8)
+        zoom_controller = Gtk.EventControllerKey()
+        zoom_controller.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
+        # F7/F8 belong to the shell's key handler, which follows every
+        # window it is attached to. Handling them here as well bound them
+        # to this window alone.
+
+        def _capture_zoom_key(_controller, keyval, _keycode, _state):
+            if keyval in space_keys and semantic_keys is not None:
+                return semantic_keys._key_pressed_cb(
+                    _controller, keyval, _keycode, _state)
+            if keyval == Gdk.KEY_F5:
+                from jarabe.journal import journalactivity
+                journalactivity.get_journal().show_journal()
+                return True
+            if keyval == Gdk.KEY_F6:
+                from jarabe import frame
+                frame.get_view().notify_key_press()
+                return True
+            if keyval == Gdk.KEY_F3:
+                actions.go_home()
+                return True
+            level = zoom_keys.get(keyval)
+            if level is None:
+                return False
+            from jarabe import frame
+            frame.get_view().hide()
+            shell_instance.get_model().set_zoom_level(level)
+            return True
+
+        zoom_controller.connect("key-pressed", _capture_zoom_key)
+        shortcut_controller = Gtk.ShortcutController()
+        shortcut_controller.set_scope(Gtk.ShortcutScope.GLOBAL)
+        def _switch_space_shortcut(_widget, _args, target):
+            if semantic_keys is None:
+                return False
+            semantic_keys._switch_space(target)
+            return True
+
+        def _escape_shell(_widget, _args):
+            from jarabe import frame
+            frame_view = frame.get_view()
+            if not frame_view.visible:
+                return False
+            frame_view.hide()
+            return True
+        shortcut_controller.add_shortcut(Gtk.Shortcut.new(
+            Gtk.KeyvalTrigger.new(Gdk.KEY_Escape, 0),
+            Gtk.CallbackAction.new(_escape_shell)))
+        for _space_key, _space_target in ((Gdk.KEY_F7, "gtk3"),
+                                           (Gdk.KEY_F8, "gtk4")):
+            _trigger = Gtk.KeyvalTrigger.new(_space_key, 0)
+            _action = Gtk.CallbackAction.new(
+                lambda _widget, _args, target=_space_target:
+                    _switch_space_shortcut(_widget, _args, target))
+            shortcut_controller.add_shortcut(Gtk.Shortcut.new(_trigger,
+                                                               _action))
+        for _shortcut_key in (Gdk.KEY_F1, Gdk.KEY_F2, Gdk.KEY_F3,
+                              Gdk.KEY_F4, Gdk.KEY_F5, Gdk.KEY_F6):
+            _trigger = Gtk.KeyvalTrigger.new(_shortcut_key, 0)
+            _action = Gtk.CallbackAction.new(
+                lambda _widget, _args, keyval=_shortcut_key:
+                    _capture_zoom_key(None, keyval, 0, 0))
+            shortcut_controller.add_shortcut(Gtk.Shortcut.new(_trigger,
+                                                               _action))
+        shell_instance._main_window.add_controller(shortcut_controller)
+        shell_instance._main_window.add_controller(zoom_controller)
+        for _focus_surface in (shell_instance._overlay, shell_instance.stack):
+            _surface_controller = Gtk.EventControllerKey()
+            _surface_controller.set_propagation_phase(
+                Gtk.PropagationPhase.CAPTURE)
+            _surface_controller.connect("key-pressed", _capture_zoom_key)
+            _focus_surface.add_controller(_surface_controller)
+        shell_instance._sugar_zoom_controller = zoom_controller
+
+        if os.environ.get('SUGAR_WINDOWED', '0') == '1':
+            shell_instance._main_window.set_decorated(False)
+            shell_instance._main_window.set_default_size(1024, 768)
+        else:
+            shell_instance._main_window.fullscreen()
+        shell_instance._main_window.present()
+
+
+def _start_intro(shell, start_on_age_page=False):
+    _setup_main_window(shell)
+    intro_box = IntroWindow(start_on_age_page=start_on_age_page)
+
+    shell.stack.add_named(intro_box, "intro")
+    shell.stack.set_visible_child_name("intro")
+    intro_box.connect('done', __intro_window_done_cb)
+
+
+def _check_profile():
+    if intro.check_profile():
+        return True
+
+    profile_name = os.environ.get("SUGAR_PROFILE_NAME", None)
+    if profile_name is not None:
+        create_profile_with_nickname(profile_name)
+        return True
+
+    return False
+
+
+def _check_group_label():
+    return intro.check_group_label()
+
+
+def main(shell):
+    logging.warning("Running main")
+
+    # Create default profile directories if they do not exist
+    profile_path = env.get_profile_path()
+    for subdir in ['datastore', 'logs', 'data']:
+        path = os.path.join(profile_path, subdir)
+        if not os.path.exists(path):
+            try:
+                os.makedirs(path, 0o770)
+            except OSError as e:
+                logging.error('Failed to create directory %s: %s', path, e)
+
+    import signal
+    signal.signal(signal.SIGINT, signal.SIG_DFL)
+
+    if HAS_GST:
+        Gst.init(sys.argv)
+
+    cleanup_temporary_files()
+
+    _start_window_manager()
+
+    setup_timezone()
+    setup_fonts()
+    setup_theme()
+    setup_proxy()
+
+    # must run early so the screen unfreezes even if blocked on intro
+    GLib.idle_add(unfreeze_screen_cb)
+
+    GLib.idle_add(setup_cursortracker_cb)
+    sound.restore()
+    brightness.get_instance()
+
+    sys.path.append(config.ext_path)
+
+    if not _check_profile():
+        _start_intro(shell)
+    elif not _check_group_label():
+        _start_intro(shell, start_on_age_page=True)
+    else:
+        _begin_desktop_startup()
+
+shell = shell.get_model()
+
+from sugar4.activity import activityfactory
+def _get_compositor_fd():
+    if shell.compositor is not None:
+        return shell.compositor.get_client_socket_fd()
+    return -1
+activityfactory.set_compositor_fd_getter(_get_compositor_fd)
+
+shell.connect('activate', main)
+shell.run(None)
