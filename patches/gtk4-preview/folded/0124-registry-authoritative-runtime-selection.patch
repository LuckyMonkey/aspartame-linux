From: Aspartame GTK4 migration
Subject: [PATCH] registry: select runtime during registration by bundle ID

Owner: Jarabe; upstreamable for mixed-runtime development registries.
Clock's legacy directory is clock.activity but the modern directory is
Clock.activity. Patch 0096 guessed paths and returned unregistered objects,
which also hid legacy entries from 0095's replacement check. Retire that
lookup workaround and make duplicate selection stable in either scan order.
GTK3 version/user-copy policy is unchanged outside the modern preview.
Remove when upstream registration provides equivalent runtime precedence.

--- a/src/jarabe/model/bundleregistry.py
+++ b/src/jarabe/model/bundleregistry.py
@@ -16,6 +16,7 @@
 
 import os
 import logging
+import shlex
 from threading import Thread, Lock
 
 from gi.repository import GObject
@@ -248,19 +249,6 @@
         with self._lock:
             for bundle in self._bundles:
                 if bundle.get_bundle_id() == bundle_id:
-                    if (os.environ.get('ASPARTAME_GTK4_PREVIEW') == '1' and
-                            'sugar-activity3' in bundle.get_command()):
-                        modern_dir = os.environ.get('SUGAR_ACTIVITIES_PATH')
-                        if modern_dir:
-                            candidate = os.path.join(modern_dir,
-                                                     os.path.basename(bundle.get_path()))
-                            try:
-                                modern = bundle_from_dir(candidate)
-                                if (modern is not None and
-                                        'sugar-activity4' in modern.get_command()):
-                                    return modern
-                            except Exception:
-                                logging.exception('Modern bundle lookup failed')
                     return bundle
         return None
 
@@ -322,10 +310,17 @@
         installed = self.get_bundle(bundle_id)
         if (installed is not None and
                 os.environ.get('ASPARTAME_GTK4_PREVIEW') == '1'):
-            installed_exec = installed.get_command()
-            bundle_exec = bundle.get_command()
-            if ('sugar-activity3' in installed_exec and
-                    'sugar-activity4' in bundle_exec):
+            # Select the runtime once, at registration, by bundle identity.
+            # Directory names and version numbers may differ across ports.
+            installed_exec = shlex.split(installed.get_command())
+            bundle_exec = shlex.split(bundle.get_command())
+            installed_modern = bool(installed_exec) and os.path.basename(
+                installed_exec[0]) == 'sugar-activity4'
+            bundle_modern = bool(bundle_exec) and os.path.basename(
+                bundle_exec[0]) == 'sugar-activity4'
+            if installed_modern and not bundle_modern:
+                return installed
+            if bundle_modern and not installed_modern:
                 logging.info('Prefer GTK4 bundle %s over GTK3 duplicate',
                              bundle_id)
                 self.remove_bundle(installed.get_path(), emit_signals=False)
