From: Aspartame GTK4 migration
Subject: [PATCH] gtk4: repair Favorites accessibility placement and init order

The older Activity accessibility patch can land against the nearby Favorites
view method when the GTK4 source has drifted. Keep the accessible button
contract on ActivityIcon itself, and initialize its lifecycle model before the
first asynchronous refresh callback can update icon state.

--- a/src/jarabe/desktop/favoritesview.py
+++ b/src/jarabe/desktop/favoritesview.py
@@ -363,11 +363,6 @@
             if hasattr(icon, 'set_resume_mode'):
                 icon.set_resume_mode(self._resume_mode)
 
-        self.set_focusable(True)
-        self.update_property([Gtk.AccessibleProperty.LABEL],
-                             [activity_info.get_name()])
-        self.set_accessible_role(Gtk.AccessibleRole.BUTTON)
-
 class ActivityIcon(CanvasIcon):
     __gtype_name__ = 'SugarFavoriteActivityIcon'
 
@@ -378,6 +373,11 @@
         CanvasIcon.__init__(self, cache=True,
                             file_name=activity_info.get_icon())
 
+        self.set_focusable(True)
+        self.update_property([Gtk.AccessibleProperty.LABEL],
+                             [activity_info.get_name()])
+        self.set_accessible_role(Gtk.AccessibleRole.BUTTON)
+
         self._activity_info = activity_info
         self._journal_entries = []
         self._resume_mode = Gio.Settings.new(
@@ -389,10 +389,10 @@
         datastore.updated.connect(self._datastore_listener_updated_cb)
         datastore.deleted.connect(self._datastore_listener_deleted_cb)
 
-        self._refresh()
-        self._update()
         self._presentation = activitypresentation.get_model()
         self._presentation.connect('changed', self._lifecycle_changed)
+        self._refresh()
+        self._update()
 
     def _refresh(self):
         bundle_id = self._activity_info.get_bundle_id()
