+    def _report_shutdown_failure(self):
+        try:
+            import jarabe.desktop.homewindow
+            from sugar4.graphics.alert import NotifyAlert
+
+            home = jarabe.desktop.homewindow.get_instance()
+            home.unbusy()
+            alert = NotifyAlert()
+            alert.props.title = _("Could not shut down")
+            alert.props.msg = _("The system did not allow it. "
+                                "Your session is still running.")
+            alert.connect('response',
+                          lambda a, response: home.remove_alert(a))
+            home.add_alert(alert)
+            alert.set_visible(True)
+        except Exception:
+            logging.exception('Could not report the failed shutdown')
+
+    def _request_system_shutdown(self):
+        """Ask the system to power off or reboot.
+
+        Returns whether the system accepted the request. The caller must not
+        tear the shell down when it did not: a refusal here used to be
+        followed by quitting anyway, which destroyed the desktop and shut
+        nothing down.
+        """
+        if self._logout_mode not in (self.MODE_SHUTDOWN, self.MODE_REBOOT):
+            return True
+
+        try:
+            bus = dbus.SystemBus()
+        except dbus.DBusException as error:
+            logging.warning('No system bus for the shutdown request: %s',
+                            error)
+            return False
+
+        if have_systemd():
+            try:
+                proxy = bus.get_object('org.freedesktop.login1',
+                                       '/org/freedesktop/login1')
+                pm = dbus.Interface(proxy, 'org.freedesktop.login1.Manager')
+
+                if self._logout_mode == self.MODE_SHUTDOWN:
+                    pm.PowerOff(False)
+                elif self._logout_mode == self.MODE_REBOOT:
+                    pm.Reboot(False)
+            except dbus.DBusException as error:
+                # A refusal is an ordinary outcome, not a crash: log it
+                # plainly so the session log does not look fatal.
+                logging.warning('System refused the shutdown request: %s',
+                                error)
+                return False
+        else:
+            CONSOLEKIT_DBUS_PATH = '/org/freedesktop/ConsoleKit/Manager'
+            try:
+                proxy = bus.get_object('org.freedesktop.ConsoleKit',
+                                       CONSOLEKIT_DBUS_PATH)
+                pm = dbus.Interface(proxy,
+                                    'org.freedesktop.ConsoleKit.Manager')
+
+                if self._logout_mode == self.MODE_SHUTDOWN:
+                    pm.Stop()
+                elif self._logout_mode == self.MODE_REBOOT:
+                    pm.Restart()
+            except dbus.DBusException as error:
+                logging.warning('System refused the shutdown request: %s',
+                                error)
+                return False
+
+        return True
+
 
