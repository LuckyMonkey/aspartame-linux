+    def __scan_clicked_cb(self, _button):
+        try:
+            addresses = subprocess.check_output(['ip', '-o', '-4', 'addr', 'show', 'scope', 'global'], text=True, timeout=5)
+            network = None
+            for line in addresses.splitlines():
+                fields = line.split()
+                if 'inet' in fields:
+                    network = str(ipaddress.ip_interface(fields[fields.index('inet') + 1]).network)
+                    break
+            if network is None:
+                raise RuntimeError('no active IPv4 network')
+            output = subprocess.check_output(['nmap', '-sn', '-T3', network], stderr=subprocess.STDOUT, text=True, timeout=45)
+        except Exception as error:
+            output = _('Scan failed: %s') % error
+        dialog = Gtk.Dialog(title=_('Neighborhood scan'), transient_for=self.get_toplevel(), flags=Gtk.DialogFlags.MODAL)
+        dialog.add_button(_('Close'), Gtk.ResponseType.CLOSE)
+        dialog.add_button(_('Save report'), Gtk.ResponseType.APPLY)
+        text_view = Gtk.TextView()
+        text_view.set_editable(False)
+        text_view.set_cursor_visible(False)
+        text_view.set_monospace(True)
+        text_view.get_buffer().set_text(output)
+        scroll = Gtk.ScrolledWindow()
+        scroll.set_size_request(900, 520)
+        scroll.add(text_view)
+        dialog.get_content_area().pack_start(scroll, True, True, 0)
+        dialog.show_all()
+        response = dialog.run()
+        if response == Gtk.ResponseType.APPLY:
+            report_dir = os.path.expanduser('~/Downloads')
+            os.makedirs(report_dir, exist_ok=True)
+            report_path = os.path.join(report_dir, 'neighborhood-scan-%s.txt' % datetime.now().strftime('%Y%m%d-%H%M%S'))
+            with open(report_path, 'w', encoding='utf-8') as report_file:
+                report_file.write(output)
+        dialog.destroy()
+
