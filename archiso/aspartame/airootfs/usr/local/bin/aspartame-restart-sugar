#!/usr/bin/env bash
set -euo pipefail

target_user=${SUGAR_USER:-aspartame}
old_pid=$(pgrep -u "$target_user" -f '^python3 -m jarabe\.main$' | head -n 1 || true)
test -n "$old_pid" || { echo "Sugar is not running for $target_user" >&2; exit 1; }

# Cover the display before the old shell disappears. A click dismisses the
# mask immediately; otherwise it fades after the replacement shell appears.
if test -x /usr/local/bin/aspartame-sugar-transition; then
    ready="/tmp/aspartame-sugar-transition-$old_pid.ready"
    rm -f "$ready"
    runuser -u "$target_user" -- env DISPLAY="${DISPLAY:-:0}" XAUTHORITY="${XAUTHORITY:-/home/$target_user/.Xauthority}" ASPARTAME_OLD_SUGAR_PID="$old_pid" ASPARTAME_TRANSITION_READY="$ready" nohup /usr/local/bin/aspartame-sugar-transition >/tmp/aspartame-sugar-transition.log 2>&1 </dev/null &
    for _ in $(seq 1 30); do
        test -e "$ready" && break
        sleep 0.1
    done
    test -e "$ready" || echo 'Sugar transition mask did not become ready; continuing safely.' >&2
    rm -f "$ready"
fi

kill -TERM "$old_pid"
for _ in $(seq 1 50); do
    test -d "/proc/$old_pid" || break
    sleep 0.1
done
if test -d "/proc/$old_pid"; then
    echo "Sugar PID $old_pid ignored SIGTERM; sending SIGKILL" >&2
    kill -KILL "$old_pid"
fi

for _ in $(seq 1 150); do
    new_pid=$(pgrep -u "$target_user" -f '^python3 -m jarabe\.main$' | head -n 1 || true)
    if test -n "$new_pid" && test "$new_pid" != "$old_pid"; then
        echo "Sugar restarted: $old_pid -> $new_pid"
        exit 0
    fi
    sleep 0.1
done
echo 'Sugar did not respawn within 15 seconds' >&2
exit 1
