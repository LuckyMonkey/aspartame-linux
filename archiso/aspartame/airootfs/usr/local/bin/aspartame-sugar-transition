#!/usr/bin/python3
"""Cover the X11 display during a Sugar shell reload, then fade away."""
import os
import time
import gi
gi.require_version('Gdk', '3.0')
gi.require_version('Gtk', '3.0')
from gi.repository import Gdk, GLib, Gtk

def shell_pids():
    result = []
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        try:
            with open('/proc/%s/cmdline' % entry, 'rb') as stream:
                command = stream.read().split(b'\0')
        except OSError:
            continue
        if command[:3] == [b'python3', b'-m', b'jarabe.main']:
            result.append(entry)
    return result

def main():
    old_pid = os.environ.get('ASPARTAME_OLD_SUGAR_PID', '')
    window = Gtk.Window()
    window.set_decorated(False)
    window.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
    window.set_skip_taskbar_hint(True)
    window.set_accept_focus(False)
    window.set_can_focus(False)
    window.set_keep_above(True)
    window.connect('destroy', Gtk.main_quit)
    window.set_opacity(1.0)
    window.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0, 0, 0, 1))
    window.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    window.connect('button-press-event', lambda *_args: (window.destroy(), False)[1])
    window.show_all()
    screen = window.get_screen()
    width = screen.get_width()
    height = screen.get_height()
    window.resize(width, height)
    window.move(0, 0)
    window.present()
    Gdk.Display.get_default().flush()
    started = time.monotonic()
    shell_seen_at = [None]
    fading = [False]
    opacity = [1.0]

    def fade():
        if not fading[0]:
            return False
        opacity[0] = max(0.0, opacity[0] - 0.0125)
        window.set_opacity(opacity[0])
        if opacity[0] <= 0.0:
            window.destroy()
            return False
        return True

    def check_shell():
        if any(pid != old_pid for pid in shell_pids()):
            if shell_seen_at[0] is None:
                shell_seen_at[0] = time.monotonic()
                return True
            if time.monotonic() - shell_seen_at[0] < 0.4:
                return True
            fading[0] = True
            GLib.timeout_add(50, fade)
            return False
        if time.monotonic() - started > 20:
            window.destroy()
            return False
        return True

    GLib.timeout_add(100, check_shell)
    Gtk.main()

if __name__ == '__main__':
    main()
