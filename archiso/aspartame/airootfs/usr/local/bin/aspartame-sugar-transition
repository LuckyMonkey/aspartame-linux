#!/usr/bin/python3
"""Four-panel Sugar reload reveal; works without an X11 compositor."""
import os
import time
import gi
gi.require_version('Gdk', '3.0')
gi.require_version('Gtk', '3.0')
from gi.repository import Gdk, GLib, Gtk

def shell_pids():
    result=[]
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        try:
            with open('/proc/%s/cmdline' % entry, 'rb') as stream:
                command=stream.read().split(b'\0')
        except OSError:
            continue
        if command[:3] == [b'python3', b'-m', b'jarabe.main']:
            result.append(entry)
    return result

def main():
    old_pid=os.environ.get('ASPARTAME_OLD_SUGAR_PID','')
    screen=Gdk.Screen.get_default()
    width,height=screen.get_width(),screen.get_height()
    half_width,half_height=width//2,height//2
    windows=[]
    for x,y in ((0,0),(half_width,0),(0,half_height),(half_width,half_height)):
        window=Gtk.Window()
        window.set_decorated(False)
        window.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
        window.set_skip_taskbar_hint(True)
        window.set_accept_focus(False)
        window.set_can_focus(False)
        window.set_keep_above(True)
        window.override_background_color(Gtk.StateFlags.NORMAL, Gdk.RGBA(0,0,0,1))
        window.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        windows.append((window,x,y))
    def close_all(*_args):
        for window,_,_ in windows:
            if window.get_window() is not None:
                window.destroy()
        return False
    for window,_,_ in windows:
        window.connect('button-press-event', close_all)
    for window,x,y in windows:
        window.show_all()
        window.resize(half_width,half_height)
        window.move(x,y)
        window.present()
    Gdk.Display.get_default().flush()
    started=time.monotonic()
    shell_seen_at=[None]
    animation_started=[False]
    progress=[0.0]
    def animate():
        if not animation_started[0]:
            return False
        progress[0]=min(1.0,progress[0]+0.04)
        distance=int(max(width,height)*progress[0])
        destinations=((-distance,-distance),(half_width+distance,-distance),(-distance,half_height+distance),(half_width+distance,half_height+distance))
        for (window,_,_), (x,y) in zip(windows,destinations):
            if window.get_window() is not None:
                window.move(x,y)
        if progress[0]>=1.0:
            close_all()
            return False
        return True
    def check_shell():
        if any(pid != old_pid for pid in shell_pids()):
            if shell_seen_at[0] is None:
                shell_seen_at[0]=time.monotonic()
                return True
            if time.monotonic()-shell_seen_at[0] < 0.4:
                return True
            animation_started[0]=True
            GLib.timeout_add(40,animate)
            return False
        if time.monotonic()-started > 20:
            close_all()
            return False
        return True
    GLib.timeout_add(100,check_shell)
    Gtk.main()
if __name__ == '__main__':
    main()
