#!/bin/sh
exec >>/dev/ttyS0 2>&1
export PYTHONFAULTHANDLER=1
export XDG_CURRENT_DESKTOP=Sugar
export XDG_SESSION_DESKTOP=sugar
# Optional live source overlay exported by QEMU at /mnt/aspartame-dev.
# A checkout placed at aspartame-dev/sugar with Python sources under src/
# overrides the packaged Sugar shell for the next session restart.
# A separate /dev/vdb data disk is optional.  When present it provides
# persistence; on a plain ISO boot Sugar uses the writable live overlay.
if mountpoint -q /home/aspartame &&
   test "$(findmnt -n -o SOURCE --target /home/aspartame)" = /dev/vdb; then
    export ASPARTAME_PERSISTENCE=persistent
else
    export ASPARTAME_PERSISTENCE=ephemeral
    install -d -o aspartame -g aspartame /home/aspartame/Desktop /home/aspartame/Downloads
fi
for _ in 1 2 3 4 5; do
    mountpoint -q /mnt/aspartame-dev && break
    sleep 1
done
if test -d /mnt/aspartame-dev/sugar/src; then
    export PYTHONPATH="/usr/share/aspartame:/mnt/aspartame-dev/sugar/src${PYTHONPATH:+:$PYTHONPATH}"
fi

# Ensure the isolated TCP SSH helper is active once networking is available.
if ! ss -ltn 2>/dev/null | grep -q ':22 '; then
    sudo -n /usr/local/sbin/aspartame-start-sshd \
        >>/var/log/aspartame-sshd.log 2>&1 &
fi

# Sugar's HomeBackgroundBox reads these settings for the Home view.
gsettings set org.sugarlabs.user.background image-path \
    /usr/share/backgrounds/aspartame-default.png
gsettings set org.sugarlabs.user.background alpha-level 1.0

# virtio-vga advertises this mode, but Xorg may initially select a smaller
# fallback. Retry briefly while the virtual output appears.
(
    for _ in 1 2 3 4 5; do
        output=$(xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}')
        if test -n "$output"; then
            xrandr --output "$output" --mode 1920x1080 2>/dev/null || \
                xrandr --fb 1920x1080 2>/dev/null || true
            break
        fi
        sleep 1
    done
) &

# Keep the graphical session recoverable during Sugar development.
mkdir -p "$HOME/.cache"
aspartame-version-overlay >/home/aspartame/.cache/aspartame-version-overlay.log 2>&1 &
while true; do
    dbus-run-session -- /usr/local/bin/aspartame-session
    sleep 1
done
