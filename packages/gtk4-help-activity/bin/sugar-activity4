#!/usr/bin/env bash
set -euo pipefail
root=${ASPARTAME_GTK4_ROOT:-/home/aspartame/Development/gtk4-preview}
toolkit="$root/sources/sugar-toolkit-gtk4/src"
export PYTHONPATH="$toolkit${PYTHONPATH:+:$PYTHONPATH}"
export PYTHON_BIN="${PYTHON_BIN:-$root/venv/bin/python}"
export ASPARTAME_GTK4_PREVIEW=1
exec "$PYTHON_BIN" -c \
    'from sugar4.activity.activityinstance import main; main()' "$@"
